# Environment for the Espresso compose devnet (espresso/docker-compose.yml) and
# its deployment script (espresso/devnet/prepare.sh).

##### L1 ######
# Image of the devnet L1 (anvil). prepare.sh dumps the L1 state with the same
# image, since anvil's state format changes across releases.
ANVIL_IMAGE=ghcr.io/foundry-rs/foundry:v1.5.1

##### Espresso dev node ######
ESPRESSO_DEV_NODE_IMAGE=ghcr.io/espressosystems/espresso-sequencer/espresso-dev-node:release-20251120-lip2p-tcp-3855
ESPRESSO_DEV_NODE_L1_DEPLOYMENT=skip
# Espresso contracts predeployed from espresso/environment/allocs.json.
ESPRESSO_SEQUENCER_FEE_CONTRACT_ADDRESS=0x0165878a594ca255338adfa4d48449f69242eb8f
ESPRESSO_SEQUENCER_ESP_TOKEN_ADDRESS=0x2279b7a0a67db372996a5fab50d91eaa73d2ebe6
ESPRESSO_SEQUENCER_PLONK_VERIFIER_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
ESPRESSO_SEQUENCER_STAKE_TABLE_ADDRESS=0x610178da211fef7d417bc0e6fed39f05609ad788
ESPRESSO_SEQUENCER_ESP_TOKEN_PROXY_ADDRESS=0x8a791620dd6260079bf849dc5567adc3f2fdc318
ESPRESSO_SEQUENCER_LIGHT_CLIENT_PROXY_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
ESPRESSO_SEQUENCER_FEE_CONTRACT_PROXY_ADDRESS=0xa513e6e4b8f2a923d98304ec87f64353c4d5c853
ESPRESSO_SEQUENCER_STAKE_TABLE_PROXY_ADDRESS=0xb7f8bc63bbcad18155201308c8f3540b07f84f5e
ESPRESSO_SEQUENCER_PLONK_VERIFIER_V2_ADDRESS=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9
ESPRESSO_SEQUENCER_API_PORT=24000
ESPRESSO_DEV_NODE_PORT=24002
ESPRESSO_BUILDER_PORT=31003

##### Ports ######
EIGENDA_PROXY_PORT=3100
L1_HTTP_PORT=8545
ROLLUP_PORT=9545
VERIFIER_PORT=9546
OP_ENGINE_PORT=8552
OP_HTTP_PORT=8546

##### Chains ######
L1_CHAIN_ID=11155111
L2_CHAIN_ID=22266222

##### Keys (all from the "test test ... junk" mnemonic) ######
# HD index 0: deployer, owner of most roles.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# HD index 1: proposer.
PROPOSER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
PROPOSER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# HD index 2: fallback batcher, the SystemConfig batcher.
FALLBACK_BATCHER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
FALLBACK_BATCHER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# HD index 3: BatchAuthenticator owner.
BATCH_AUTHENTICATOR_OWNER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
BATCH_AUTHENTICATOR_OWNER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# HD index 6: Espresso batcher, registered in the BatchAuthenticator.
ESPRESSO_BATCHER_ADDRESS=0x976EA74026E726554dB657fA54763abd0C3a0aa9
ESPRESSO_BATCHER_PRIVATE_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e
